# TrackVibe backend environment.
# Copy to .env (loaded first), with optional .env.development / .env.production overrides.
# Vars marked [prod: required] make startup fail in NODE_ENV=production when missing.

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3000
HOST=
NODE_ENV=development
LOG_LEVEL=debug

# ─── Database (PostgreSQL) ───────────────────────────────────────────────────
DATABASE_URL=postgres://user:password@localhost:5432/trackvibe
DB_POOL_MAX=10
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_FORCE_IPV4=false
# Skip CREATE TABLE IF NOT EXISTS on boot (always skipped in production; use npm run migrate:up)
SKIP_SCHEMA_INIT=false
# Log queries slower than this many milliseconds
SLOW_QUERY_MS=200

# ─── Auth & security ─────────────────────────────────────────────────────────
# [prod: required] HS256 signing secret for JWTs
JWT_SECRET=
# [prod: required] Explicit origin(s), comma-separated. Never "true" in production.
CORS_ORIGIN=http://localhost:5173
# [prod: required] Used for links in emails and OAuth redirects
FRONTEND_ORIGIN=http://localhost:5173
APP_BASE_URL=
API_RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=10

# ─── OAuth providers (optional) ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_REDIRECT_URI=

# ─── AI (Google Gemini) ──────────────────────────────────────────────────────
# Voice understanding, food lookup, chat, and embeddings return 503 when unset
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_LIVE_MODEL=
VOICE_STREAMING=true
VOICE_EXECUTE_ON_SERVER=true

# ─── Redis (strongly recommended in production) ──────────────────────────────
# Without it, rate limiting, the voice job queue, and the JWT logout blocklist
# fall back to in-memory stores that don't work across multiple instances.
REDIS_URL=
# Alternative var honored when REDIS_URL is unset (e.g. Railway)
REDIS_PRIVATE_URL=

# ─── Events & workers ────────────────────────────────────────────────────────
# 'redis' (default) or 'sqs'
EVENT_TRANSPORT=redis
EVENT_QUEUE_URL=
VOICE_QUEUE_URL=
# Run voice/event workers as separate processes instead of in the API process
SEPARATE_WORKERS=false

# ─── AWS (S3 uploads, SQS transport) ─────────────────────────────────────────
# Credentials come from AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY or an instance role
AWS_REGION=
AWS_S3_BUCKET=

# ─── Optional bounded-context databases / microservices ──────────────────────
BODY_DATABASE_URL=
ENERGY_DATABASE_URL=
GOALS_DATABASE_URL=
BODY_SERVICE_URL=
ENERGY_SERVICE_URL=
GOALS_SERVICE_URL=

# ─── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM=

# ─── Web push notifications ──────────────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# ─── Subscriptions (Lemon Squeezy) ───────────────────────────────────────────
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_VARIANT_ID_MONTHLY=
LEMONSQUEEZY_VARIANT_ID_YEARLY=

# ─── WhatsApp integration (optional) ─────────────────────────────────────────
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=trackvibe-whatsapp-verify
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Meta App Secret — REQUIRED to process incoming messages. The webhook verifies
# X-Hub-Signature-256 with it and returns 503 when it is unset, because the
# endpoint reaches an LLM that can write and delete user data.
WHATSAPP_APP_SECRET=

# ─── MCP server impersonation (local AI tooling) ─────────────────────────────
TRACKVIBE_MCP_SECRET=
TRACKVIBE_MCP_USER_ID=
